# Local / CI environment template.
# Copy to `.env` for local overrides — never commit real secrets.

# Postgres (docker compose or Homebrew / hosted)
POSTGRES_USER=asa
POSTGRES_PASSWORD=asa
POSTGRES_DB=asa
DATABASE_URL=postgresql://asa:asa@localhost:5432/asa

# Shared by Fastify (`apps/api`) and FastAPI (`apps/api-python`)
# JWT_SECRET must be at least 32 characters
JWT_SECRET=change-me-min-32-chars-long-secret!!
API_PORT=3000
# true behind HTTPS in production
COOKIE_SECURE=false
# Comma-separated browser origins allowed for credentialed CORS
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development

# Public web URL (email verify / reset links)
APP_PUBLIC_URL=http://localhost:5173

# Brevo transactional email — https://developers.brevo.com/
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.example
BREVO_SENDER_NAME=App
# false = no-op mailer (local/CI); true = real sends
BREVO_ENABLED=false

# Auth email token TTLs
AUTH_VERIFY_EMAIL_TTL_MINUTES=60
AUTH_RESET_PASSWORD_TTL_MINUTES=30
