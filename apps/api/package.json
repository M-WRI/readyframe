{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:push": "node --env-file=../../.env ./node_modules/prisma/build/index.js db push",
    "db:deploy": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/client": "^6.6.0",
    "@repo/contracts": "workspace:*",
    "argon2": "^0.41.1",
    "fastify": "^5.3.2",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^6.0.10",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.14.1",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.25.1",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^3.1.1"
  }
}
