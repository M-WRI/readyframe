generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum AuthEmailTokenType {
  email_verify
  password_reset
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            UserRole         @default(user)
  emailVerifiedAt DateTime?
  pendingEmail    String?
  createdAt       DateTime         @default(now())
  refreshSessions RefreshSession[]
  authEmailTokens AuthEmailToken[]
}

model RefreshSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuthEmailToken {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthEmailTokenType
  tokenHash String             @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([userId, type])
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  method       String
  path         String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())
}
